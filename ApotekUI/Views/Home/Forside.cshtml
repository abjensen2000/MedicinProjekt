@using DTO
@model ApotekDTO
@{
    ViewData["Title"] = "Forside";
}

<h1>Velkommen til receptportalen</h1>

@if (Model != null)
{
    <p>Logget ind som: @Model.Navn</p>
}

<p>Indtast CPR-nummer på patient</p>
<form method="post" asp-action="Forside" asp-controller="Home">
    @if (Model != null)
    {
        <input type="hidden" name="apotekID" value="@Model.Id" />
    }
    <input name="cprnummer" id="cprnummer" type="text" placeholder="PatientCPR" />
    <input type="submit" value="Søg" />
</form>

@if (ViewBag.Error != null)
{
    <p>@ViewBag.Error</p>
}
@if (ViewBag.Message != null)
{
    <p>@ViewBag.Message</p>
}
<!--Alternativ til form: 
    <form method="post" action="/Home/Forside">
    Men hvis route ændres til /soeg/patient
    Så skal alle form methods der bruger det endpoints ændres.
    I det brugte eksempel leder api først efter controller "Home", og så metode "Forside".
    Så hvis man laver route om, leder den stadig efter Forside metode, der så har fået ny route


-->
